# Linux 서버 (k8s-vga-worker2) 용
# 사용법: cp .env.linux .env && docker compose up -d

OLLAMA_BASE_URL=http://172.17.0.1:11434
DEFAULT_OLLAMA_MODEL=gemma4:26b

# DPE
DPE_ENABLED=true
DPE_BASE_URL=http://dpe:8200
DPE_TIMEOUT_SECONDS=600
DPE_NORMALIZATION_ENABLED=true
DPE_NORMALIZATION_MIN_CONFIDENCE=0.55
DPE_BACKEND_SELF_URL=http://backend:8000
