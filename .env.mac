# Mac 로컬 테스트용
# 사용법: cp .env.mac .env && docker compose up -d

OLLAMA_BASE_URL=http://host.docker.internal:11434
DEFAULT_OLLAMA_MODEL=exaone3.5:7.8b

# DPE
DPE_ENABLED=true
DPE_BASE_URL=http://dpe:8200
DPE_TIMEOUT_SECONDS=1200
DPE_NORMALIZATION_ENABLED=true
DPE_NORMALIZATION_MIN_CONFIDENCE=0.55
DPE_BACKEND_SELF_URL=http://backend:8000
